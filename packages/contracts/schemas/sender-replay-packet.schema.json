{
  "$defs": {
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "snapshot": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCapture"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "available_at"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "inspection_complete": {
          "title": "Inspection Complete",
          "type": "boolean"
        },
        "message_id": {
          "pattern": "^[A-Za-z0-9_.:/+=-]{1,2048}$",
          "title": "Message Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_version": {
          "pattern": "^[A-Za-z0-9_.:/+=-]{1,2048}$",
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "message_id",
        "source_version",
        "observed_at",
        "received_at",
        "inspection_complete",
        "source_digest"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "mailbox_id": {
          "format": "uuid",
          "title": "Mailbox Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "mailbox_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SourceCapture": {
      "additionalProperties": false,
      "description": "Raw replay material, not an assertion that JSON authenticates its own source.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "copies": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1000,
          "title": "Copies",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "pagination_complete": {
          "default": false,
          "title": "Pagination Complete",
          "type": "boolean"
        },
        "publisher": {
          "additionalProperties": true,
          "title": "Publisher",
          "type": "object"
        },
        "query": {
          "additionalProperties": true,
          "title": "Query",
          "type": "object"
        },
        "query_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:/+=-]{1,2048}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Id"
        },
        "records": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1000,
          "title": "Records",
          "type": "array"
        },
        "sent_folder_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:/+=-]{1,2048}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sent Folder Id"
        },
        "state": {
          "enum": [
            "complete",
            "pending",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "captured_at",
        "expires_at"
      ],
      "title": "SourceCapture",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "frames": {
      "items": {
        "$ref": "#/$defs/Frame"
      },
      "maxItems": 2000,
      "title": "Frames",
      "type": "array"
    },
    "observation": {
      "$ref": "#/$defs/Observation"
    }
  },
  "required": [
    "observation",
    "frames"
  ],
  "title": "DetectorPacket",
  "type": "object"
}
